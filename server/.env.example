# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# Never put real credentials in this file - copy it to .env and fill in values there.
MONGODB_URI=

# Authentication / security configuration
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep real values ONLY in server/.env - never commit them or log them.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=7d

# Cost factor for bcrypt password hashing (10-15 is the production range)
BCRYPT_SALT_ROUNDS=12

# How long a password-reset token stays valid, in minutes
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# How long an email-verification token stays valid, in minutes
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# How long an account-activation token stays valid, in minutes
ACCOUNT_ACTIVATION_TOKEN_TTL_MINUTES=1440

# Frontend base URL used to build verification links sent by email
APP_FRONTEND_URL=http://localhost:5173

# CORS origin for frontend requests (must match frontend domain in production)
# Leave empty to use default (localhost:5173 in development)
CORS_ORIGIN=

# SMTP provider configuration (verification emails)
# Leave empty to run without a mail provider - verification emails are then skipped
# with a warning. Real credentials belong ONLY in server/.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Mentriv <no-reply@your-domain.com>

# Qdrant vector database
# Default: http://localhost:6333 (local Qdrant instance)
# For Qdrant Cloud, use the cluster URL from https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mentriv_knowledge

# Embedding model (runs locally via @xenova/transformers)
# Default: BAAI/bge-small-en-v1.5 (384-dimensional)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# OpenRouter LLM configuration (OpenAI-compatible API)
# Get your API key at https://openrouter.ai/keys
# Keep real values ONLY in server/.env - never commit them or log them.
OPENROUTER_API_KEY=

# LLM model to use via OpenRouter
# Default: openrouter/free
LLM_MODEL=openrouter/free

# Groq LLM configuration (OpenAI-compatible API)
# Get your API key at https://console.groq.com/keys
# This is a fallback provider - the system tries OpenRouter first.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini LLM configuration
# Get your API key at https://aistudio.google.com/apikey
# This is a fallback provider - the system tries Groq before this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
